{
  "name": "harmonarium",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Harmonarium: a galaxy-themed EPUB and PDF reader and reading tracker for Android, Linux and Windows, synced through your own Google Sheet.",
  "scripts": {
    "predev": "node scripts/copy-pdfjs.mjs",
    "prebuild": "node scripts/copy-pdfjs.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons": "tauri icon app-icon.png",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk",
    "build:sailfish": "node scripts/copy-pdfjs.mjs && vite build --outDir sailfish/www --emptyOutDir",
    "test:reader": "vite build && node tests/e2e/reader.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-http": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "construct-style-sheets-polyfill": "^3.1.0",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^6.2.108"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "vite": "^6.0.0",
    "playwright": "^1.48.0",
    "jszip": "^3.10.1"
  }
}
