{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Starborn",
  "version": "0.2.0",
  "identifier": "com.isaakrichards.starborn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Starborn",
        "width": 1280,
        "height": 840,
        "minWidth": 360,
        "minHeight": 520,
        "backgroundColor": "#070914"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Galaxy-themed EPUB reader and reading tracker",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "longDescription": "Read EPUBs, keep your reading lists, and pick up where you left off on any device, all synced through your own Google Sheet."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5MjkxQjk5ODE2M0FGREMKUldUY3IyT0JtUnNwNmZvU0IyUjYvT0d0VUljdGJTTklGRVFsSGU4V2w2Nk5GYWRXNDVVSk92czkK",
      "endpoints": [
        "https://github.com/IsaakRichards/Starborn/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
