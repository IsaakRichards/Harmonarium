{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Desktop-only permissions: the in-app updater (Windows, Linux AppImage) and opening the releases page",
  "platforms": [
    "linux",
    "windows",
    "macOS"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/IsaakRichards/Starborn/*"
        }
      ]
    }
  ]
}
